              <calculation class='tableau' formula='IF [frequency] &gt;= 5 AND [monetary] &gt;= 2000 THEN&#13;&#10;&quot;High Value Customer&quot;&#13;&#10;&#13;&#10;ELSEIF [frequency] &gt;= 3 AND [monetary] &gt;= 1000 THEN&#13;&#10;&quot;Loyal Customer&quot;&#13;&#10;&#13;&#10;ELSEIF [monetary] &gt;= 1000 THEN&#13;&#10;&quot;Big Spender&quot;&#13;&#10;&#13;&#10;ELSEIF [frequency] &gt;= 2 THEN&#13;&#10;&quot;Potential Customer&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&quot;Low Value Customer&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column-instance column='[monetary]' derivation='Avg' name='[avg:monetary:qk]' pivot='key' type='quantitative' />
